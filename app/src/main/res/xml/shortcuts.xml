<?xml version="1.0" encoding="utf-8"?>
<shortcuts xmlns:android="http://schemas.android.com/apk/res/android">
    <shortcut android:shortcutId="scan" android:enabled="true" android:icon="@drawable/ic_shortcut_scan"
        android:shortcutShortLabel="@string/sc_scan" android:shortcutLongLabel="@string/sc_scan">
        <intent android:action="com.oamsapps.pdfzy.OPEN_TOOL" android:targetPackage="com.oamsapps.pdfzy"
            android:targetClass="com.oamsapps.pdfzy.ui.MainActivity">
            <extra android:name="op" android:value="Scan document" />
        </intent>
    </shortcut>
    <shortcut android:shortcutId="compress" android:enabled="true" android:icon="@drawable/ic_shortcut_compress"
        android:shortcutShortLabel="@string/sc_compress" android:shortcutLongLabel="@string/sc_compress">
        <intent android:action="com.oamsapps.pdfzy.OPEN_TOOL" android:targetPackage="com.oamsapps.pdfzy"
            android:targetClass="com.oamsapps.pdfzy.ui.MainActivity">
            <extra android:name="op" android:value="Compress PDF" />
        </intent>
    </shortcut>
    <shortcut android:shortcutId="images" android:enabled="true" android:icon="@drawable/ic_shortcut_images"
        android:shortcutShortLabel="@string/sc_images" android:shortcutLongLabel="@string/sc_images">
        <intent android:action="com.oamsapps.pdfzy.OPEN_TOOL" android:targetPackage="com.oamsapps.pdfzy"
            android:targetClass="com.oamsapps.pdfzy.ui.MainActivity">
            <extra android:name="op" android:value="Images to PDF" />
        </intent>
    </shortcut>
</shortcuts>
